<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.lawyer_archives">

    <!-- مجوزها -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />

    <application
	    android:name=".MyApplication"
        android:allowBackup="true"
        android:appComponentFactory="androidx.core.app.CoreComponentFactory"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:extractNativeLibs="false"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.LawyerArchives"
        android:usesCleartextTraffic="false"
        tools:targetApi="31">

        <!-- صفحه اول (اسپلش) -->
        <activity
            android:name=".activities.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.AppCompat.Light.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- این دو تا حتماً باشن (مشکل کرش از همین بود) -->
        <activity
            android:name=".activities.SetupProfileActivity"
            android:exported="false" />

        <activity
            android:name=".activities.DashboardActivity"
            android:exported="false" />

        <!-- ورود و ثبت‌نام -->
        <activity android:name=".activities.LoginActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".activities.RegisterActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".activities.MainActivity" android:exported="false" android:screenOrientation="portrait" android:windowSoftInputMode="adjustResize" />

        <!-- Client Activities -->
        <activity android:name=".activities.ClientListActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".activities.SessionsActivity" android:exported="false" android:label="جلسات دادگاه" />
        <activity android:name=".activities.ClientsActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".activities.AddClientActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".activities.AddRealClientActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".activities.EditRealClientActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".activities.AddLegalClientActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".activities.EditLegalClientActivity" android:exported="false" android:screenOrientation="portrait" />

        <!-- Case Activities -->
        <activity android:name=".activities.CaseListActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".activities.AddCaseActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".activities.EditCaseActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".activities.CasesActivity" android:exported="false" android:screenOrientation="portrait" />

        <!-- Court Sessions -->
        <activity android:name=".activities.CourtSessionsActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".activities.AddCourtSessionActivity" android:exported="false" android:screenOrientation="fullSensor" />
        <activity android:name=".activities.EditCourtSessionActivity" android:exported="false" android:screenOrientation="portrait" />

        <!-- Meetings -->
        <activity android:name=".activities.MeetingsActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".activities.AddMeetingActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".activities.EditMeetingActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".activities.AddGeneralMeetingActivity" android:exported="false" android:screenOrientation="fullSensor" />

        <!-- Documents -->
        <activity android:name=".activities.AddDocumentActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".activities.DocumentsActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".activities.CaseDocumentsActivity" android:exported="false" android:screenOrientation="portrait" />

        <!-- Tasks -->
        <activity android:name=".activities.AddDailyTaskActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".activities.EditDailyTaskActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".activities.DailyTasksActivity" android:exported="false" android:screenOrientation="portrait" />

        <!-- سایر -->
        <activity android:name=".activities.GeneralMeetingsActivity" android:exported="false" />
        <activity android:name=".activities.SettingsActivity" android:exported="false" />

        <!-- Receivers -->
        <receiver
            android:name=".receivers.MeetingReminderReceiver"
            android:enabled="true"
            android:exported="false" />

        <receiver
            android:name=".receivers.BootCompletedReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter android:priority="1000">
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!-- File Provider -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>
</manifest>