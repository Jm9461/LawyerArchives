<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activities.EditDailyTaskActivity">

    <!-- AppBar با Toolbar -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="?attr/colorPrimary"
            app:title="ویرایش وظیفه روزانه"
            app:navigationIcon="?android:attr/homeAsUpIndicator"
            app:titleTextColor="@android:color/white" />

    </com.google.android.material.appbar.AppBarLayout>

    <!-- محتوای اصلی (اسکرول‌شونده) -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- نوع وظیفه -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/actEditDailyTaskAutoCompleteTaskType"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:hint="نوع وظیفه">

                <AutoCompleteTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- توضیحات -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/actEditDailyTaskDescription"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:hint="توضیحات وظیفه">

                <com.google.android.material.textfield.TextInputEditText
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textMultiLine"
                    android:minLines="4" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- انتخاب تاریخ -->
            <Button
                android:id="@+id/actEditDailyTaskBtnSelectDate"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="انتخاب تاریخ"
                android:textColor="?attr/colorPrimary" />

            <!-- انتخاب زمان -->
            <Button
                android:id="@+id/actEditDailyTaskBtnSelectTime"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:text="انتخاب زمان"
                android:textColor="?attr/colorPrimary" />

            <!-- دکمه بروزرسانی -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/actEditDailyTaskBtnUpdate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="بروزرسانی وظیفه"
                android:textColor="@android:color/white"
                app:backgroundTint="@color/design_default_color_primary" />

            <!-- دکمه حذف -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/actEditDailyTaskBtnDelete"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="حذف وظیفه"
                android:textColor="@android:color/white"
                app:backgroundTint="@color/design_default_color_error" />

        </LinearLayout>
    </ScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>