<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <EditText
            android:id="@+id/etFormationDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="تاریخ تشکیل پرونده"
            android:inputType="date"/>

        <EditText
            android:id="@+id/etClientName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="نام موکل"
            android:inputType="textPersonName"/>

        <EditText
            android:id="@+id/etClientRole"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="نقش موکل"
            android:inputType="text"/>

        <EditText
            android:id="@+id/etCaseSubject"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="موضوع پرونده"
            android:inputType="textMultiLine"
            android:minLines="3"/>

        <EditText
            android:id="@+id/etCaseStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="وضعیت پرونده"
            android:inputType="text"/>

        <EditText
            android:id="@+id/etCaseProcess"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="روند پرونده"
            android:inputType="textMultiLine"
            android:minLines="2"/>

        <EditText
            android:id="@+id/etArchiveNumber"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="شماره بایگانی"
            android:inputType="number"/>

        <EditText
            android:id="@+id/etCityJudiciary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="دادگاه شهر"
            android:inputType="text"/>

        <EditText
            android:id="@+id/etCourtLevelType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="نوع و سطح دادگاه"
            android:inputType="text"/>

        <EditText
            android:id="@+id/etOpponentInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="اطلاعات طرف مقابل"
            android:inputType="textMultiLine"
            android:minLines="2"/>

        <EditText
            android:id="@+id/etPowerOfAttorneyNumber"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="شماره وکالتنامه"
            android:inputType="number"/>

        <Button
            android:id="@+id/saveCaseButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ذخیره تغییرات"
            android:layout_marginTop="16dp"/>

    </LinearLayout>
</ScrollView>